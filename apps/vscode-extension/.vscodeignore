# Exclude everything by default. Also block VSCE's traversal above this workspace
# package root when npm workspaces are present.
**/*
../*
../../**

# Never package environment files, including parent workspace env files.
**/.env
**/.env.*
../api/.env
../api/.env.*
../../.env
../../.env.*

# Include compiled extension runtime JavaScript (never maps, tests, or mocks).
!out/**/*.js
out/**/*.test.js
out/**/*.map
out/test/**

# Runtime extension assets and Marketplace metadata.
!media/
!media/**
!resources/
!resources/**
!package.json
!README.md
!LICENSE.md

# Include the locally installed production dependency tree only.
!node_modules/**

# Apply env exclusions after runtime dependency inclusion as a final safeguard.
**/.env
**/.env.*
**/*.map
**/*.test.*
**/test/**
**/tests/**
**/example/**
**/examples/**
**/.github/**
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/.github/**
node_modules/**/*.map
node_modules/**/*.test.js
node_modules/.package-lock.json
../api/.env
../api/.env.*
../../.env
../../.env.*

.vsix-staging/**
