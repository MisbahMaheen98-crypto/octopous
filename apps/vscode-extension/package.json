{
  "name": "octopus-ghost",
  "displayName": "OCTOPUS Ghost",
  "description": "One-click project snapshot capture from VS Code to OCTOPUS.",
  "version": "0.1.6",
  "license": "SEE LICENSE IN LICENSE.md",
  "publisher": "octopus-ghost",
  "icon": "resources/octopus.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afifacoding/octopus"
  },
  "homepage": "https://octopus-web-ecdc.onrender.com",
  "bugs": {
    "url": "https://github.com/Afifacoding/octopus/issues"
  },
  "keywords": [
    "octopus",
    "snapshot",
    "backup",
    "workspace",
    "project-capture",
    "developer-tools"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onCommand:octopus.openControlPanel",
    "onCommand:octopus.saveSnapshot",
    "onCommand:octopus.connectAccount",
    "onCommand:octopus.selectProject",
    "onCommand:octopus.openWebApp",
    "onCommand:octopus.rollbackSnapshot",
    "onCommand:octopus.compareSnapshot",
    "onCommand:octopus.refreshSnapshots",
    "onView:octopus.workspaceView",
    "onView:octopus.snapshotHistoryView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "octopus.openControlPanel",
        "title": "OCTOPUS: Open Control Panel"
      },
      {
        "command": "octopus.saveSnapshot",
        "title": "OCTOPUS: Save Snapshot",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "octopus.rollbackSnapshot",
        "title": "OCTOPUS: Rollback to Snapshot",
        "icon": "$(history)"
      },
      {
        "command": "octopus.compareSnapshot",
        "title": "OCTOPUS: Compare Snapshot with Workspace",
        "icon": "$(diff)"
      },
      {
        "command": "octopus.refreshSnapshots",
        "title": "OCTOPUS: Refresh Snapshots",
        "icon": "$(refresh)"
      },
      {
        "command": "octopus.connectAccount",
        "title": "OCTOPUS: Connect Account",
        "icon": "$(account)"
      },
      {
        "command": "octopus.selectProject",
        "title": "OCTOPUS: Select Project"
      },
      {
        "command": "octopus.openWebApp",
        "title": "OCTOPUS: Open Web App"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "octopus.saveSnapshot",
          "when": "view == octopus.workspaceView",
          "group": "navigation@1"
        },
        {
          "command": "octopus.rollbackSnapshot",
          "when": "view == octopus.workspaceView || view == octopus.snapshotHistoryView",
          "group": "navigation@2"
        },
        {
          "command": "octopus.compareSnapshot",
          "when": "view == octopus.workspaceView || view == octopus.snapshotHistoryView",
          "group": "navigation@3"
        },
        {
          "command": "octopus.refreshSnapshots",
          "when": "view == octopus.workspaceView || view == octopus.snapshotHistoryView",
          "group": "navigation@4"
        },
        {
          "command": "octopus.connectAccount",
          "when": "view == octopus.workspaceView",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "octopus.rollbackSnapshot",
          "when": "viewItem == snapshotItem || viewItem == snapshotItemLatest",
          "group": "inline@1"
        },
        {
          "command": "octopus.compareSnapshot",
          "when": "viewItem == snapshotItem || viewItem == snapshotItemLatest",
          "group": "inline@2"
        },
        {
          "command": "octopus.rollbackSnapshot",
          "when": "viewItem == snapshotItem || viewItem == snapshotItemLatest"
        },
        {
          "command": "octopus.compareSnapshot",
          "when": "viewItem == snapshotItem || viewItem == snapshotItemLatest"
        }
      ]
    },
    "configuration": {
      "title": "OCTOPUS",
      "properties": {
        "octopus.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000/api/v1",
          "description": "Custom OCTOPUS API URL used when environment is set to custom"
        },
        "octopus.environment": {
          "type": "string",
          "enum": [
            "development",
            "production",
            "custom"
          ],
          "default": "production",
          "description": "Select which OCTOPUS environment URLs the extension should use"
        },
        "octopus.developmentApiBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000/api/v1",
          "description": "Development OCTOPUS API URL"
        },
        "octopus.productionApiBaseUrl": {
          "type": "string",
          "default": "https://octopus-api-yuc1.onrender.com/api/v1",
          "description": "Production OCTOPUS API URL"
        },
        "octopus.webBaseUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "Custom OCTOPUS web URL used when environment is set to custom"
        },
        "octopus.developmentWebBaseUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "Development OCTOPUS web application URL"
        },
        "octopus.productionWebBaseUrl": {
          "type": "string",
          "default": "https://octopus-web-r33z.onrender.com",
          "description": "Production OCTOPUS web application URL"
        },
        "octopus.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "description": "HTTP timeout in milliseconds for OCTOPUS API requests"
        },
        "octopus.capture.maxUploadBytes": {
          "type": "number",
          "default": 31457280,
          "minimum": 100000,
          "description": "Maximum packaged archive size in bytes before upload"
        },
        "octopus.capture.maxFiles": {
          "type": "number",
          "default": 50000,
          "minimum": 100,
          "description": "Maximum number of files captured from workspace"
        },
        "octopus.capture.maxDirectories": {
          "type": "number",
          "default": 10000,
          "minimum": 10,
          "description": "Maximum number of directories captured from workspace"
        },
        "octopus.capture.maxTotalBytes": {
          "type": "number",
          "default": 150000000,
          "minimum": 1000000,
          "description": "Maximum scanned workspace size in bytes before packaging"
        },
        "octopus.capture.excludeSensitiveFiles": {
          "type": "boolean",
          "default": false,
          "description": "Exclude known sensitive files from capture"
        },
        "octopus.capture.excludePatterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional glob patterns to exclude from workspace capture"
        },
        "octopus.capture.analyzeSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Enable backend static secret detection after snapshot capture"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "octopus",
          "title": "OCTOPUS",
          "icon": "media/octopus-activitybar.svg"
        }
      ]
    },
    "views": {
      "octopus": [
        {
          "id": "octopus.workspaceView",
          "name": "Workspace"
        },
        {
          "id": "octopus.snapshotHistoryView",
          "name": "Snapshot History"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -watch -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --exclude out/**",
    "package:vsix": "npm run build && node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.1",
    "vscode": "^1.1.37"
  }
}
